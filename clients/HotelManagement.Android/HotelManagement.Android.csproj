  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../HotelManagement.Client/HotelManagement.Client.csproj" /></ItemGroup>
  <ItemGroup><AndroidMavenLibrary Include="com.caverock:androidsvg-aar" Version="1.4" /></ItemGroup>
