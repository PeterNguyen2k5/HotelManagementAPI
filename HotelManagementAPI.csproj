<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Published apps can use shared-framework assemblies instead of package DLLs. -->
    <RuntimeFrameworkVersion>8.0.33</RuntimeFrameworkVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>HotelManagementAPI-77681bb6-11c9-4247-9dda-2acdf41651fe</UserSecretsId>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Native clients have their own SDKs, entry points and publish outputs. -->
    <Compile Remove="clients/**/*.cs" />
    <Content Remove="clients/**" />
    <None Remove="clients/**" />
    <Content Remove="**/recovery-settings.json" />
    <FrameworkReference Update="Microsoft.AspNetCore.App" RuntimeFrameworkVersion="$(RuntimeFrameworkVersion)" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.33" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.33" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.33">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- Audit JSON explicitly as well as requiring the patched shared runtime above. -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

</Project>
